{
  "name": "dsh-vision-harness",
  "version": "0.2.0",
  "description": "Vision 套件的 Harness 护栏：失败预设按 generation 缓存、client-modules 每批只扫一次插件树。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "vision",
    "harness"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./standing-guard.js",
  "exports": {
    ".": "./standing-guard.js",
    "./scan": "./scan-guard.js",
    "./package.json": "./package.json"
  },
  "files": [
    "standing-guard.js",
    "scan-guard.js",
    "lib/dsh-home.mjs",
    "lib/harness-log.mjs",
    "lib/standing-failure-cache.mjs",
    "lib/scan-batch.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "biome check standing-guard.js scan-guard.js lib test scripts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "c8 --all --check-coverage --statements 75 --branches 60 --functions 60 --lines 75 --reporter=text-summary --reporter=html node scripts/run-tests.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "quality": "npm run lint && npm run typecheck && npm run test:coverage && npm run pack:check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.17.57",
    "c8": "^10.1.3",
    "typescript": "^5.8.3"
  }
}
